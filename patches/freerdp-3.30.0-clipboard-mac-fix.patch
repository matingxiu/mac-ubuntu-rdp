+/// On macOS, SDL_HasClipboardData() uses UTI conformance matching
+/// (canReadItemWithDataConformingToTypes:) which can return true for mime types
+/// that SDL_GetClipboardData() (exact match via dataForType:) cannot actually read.
+/// This causes Mac→remote clipboard sync to fail: getCurrentTextMime() picks
+/// "text/plain" (UTI-conformant), but SDL_GetClipboardData("text/plain") returns NULL.
+/// Workaround for SDL3 Cocoa Has/Get mismatch (FreeRDP issue #13118):
+/// validate with an actual read instead of trusting SDL_HasClipboardData alone.
 [[nodiscard]]
+static bool sdlHasClipboardData(const char* mime)
+{
+	if (!SDL_HasClipboardData(mime))
+		return false;
+	size_t size = 0;
+	auto data = std::shared_ptr<void>(SDL_GetClipboardData(mime, &size), SDL_free);
+	return (data && (size > 0));
+}
